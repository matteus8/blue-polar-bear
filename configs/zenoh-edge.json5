// Zenoh Edge Agent Configuration (Pi 5 Companion Computer)
{
  mode: "client",
  metadata: {
    name: "edge-node-01",
    role: "Vehicle-Companion-Pi5"
  },
  connect: {
    endpoints: [
      "tcp/127.0.0.1:7447"
    ],
    timeout_ms: 5000,
    retry: {
      period_init_ms: 1000,
      period_max_ms: 5000,
      period_increase_factor: 2
    }
  }
}
