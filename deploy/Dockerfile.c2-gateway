FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/c2-gateway ./cmd/c2-gateway

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /bin/c2-gateway /bin/c2-gateway
COPY web/ /app/web/
EXPOSE 8080
ENTRYPOINT ["/bin/c2-gateway", "-web-dir", "/app/web"]
