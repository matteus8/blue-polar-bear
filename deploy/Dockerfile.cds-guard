FROM golang:1.23-alpine AS builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /bin/cds-guard ./cmd/cds-guard

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/cds-guard /bin/cds-guard
VOLUME ["/logs"]
EXPOSE 8081
ENTRYPOINT ["/bin/cds-guard"]
